# Copiar a .env (ignorado por git) y completar con valores reales.
# Nunca commitear este archivo con valores reales.

# PostgreSQL propio: en produccion, la base ai_sdlc_pro del PostgreSQL nativo
# de la VM; en local, el de docker-compose.yml de este directorio.
DATABASE_URL=postgres://ai_sdlc_dev:dev_password_local_only@localhost:5432/ai_sdlc_pro

# OAuth App de GitHub (Settings -> Developer settings -> OAuth Apps).
# Callback URL registrada en GitHub debe ser exactamente
# `${PUBLIC_BASE_URL}/api/auth/callback`.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Secreto para firmar el JWT de sesion propio (reemplaza el JWT que hoy
# emite GoTrue). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SIGNING_SECRET=

# Origen publico del backend (sin slash final). En local: http://localhost:8787
PUBLIC_BASE_URL=http://localhost:8787
# A donde redirigir tras el login/logout (el sitio estatico).
FRONTEND_URL=http://localhost:8080

PORT=8787
# Interfaz en la que escucha. Por defecto 127.0.0.1: nginx es la unica
# puerta publica. Usar 0.0.0.0 solo a proposito (por ejemplo, en un contenedor).
HOST=127.0.0.1
NODE_ENV=development

# Secreto de la notificacion de Paddle que apunta a
# https://<dominio>/api/webhooks/paddle (Paddle > Developer tools >
# Notifications). Nunca en el repo.
PADDLE_WEBHOOK_SECRET=

# Opcional: URL de un webhook de Slack/Discord para alertas operativas
# (ver backend/src/routes/webhooks/alertas.ts).
ALERTAS_WEBHOOK_URL=
